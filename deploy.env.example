# Deployment target. Copy to `deploy.env` (gitignored) and fill in.
#
#     cp deploy.env.example deploy.env && $EDITOR deploy.env
#
# The Makefile includes deploy.env if present, so `make deploy` and
# `make check-server` pick these up with no flags. Nothing here belongs in a
# public repository, which is why the real file is ignored.

# SSH destination for the web server.
DEPLOY_HOST = user@host.example

# Private key for that host.
SSH_KEY = $(HOME)/.ssh/your-key.pem

# nginx document root on the server.
DEPLOY_PATH = /var/www/html

# Staging directory in the deploy user's home (rsync lands here, then a
# privileged rsync moves it into DEPLOY_PATH).
STAGING_DIR = /home/user/site

# Git remote the server pulls from, used by server/install.sh.
GIT_REMOTE = https://github.com/commuted/eon.git
